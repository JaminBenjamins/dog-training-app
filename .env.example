PORT=3000
FRONTEND_ORIGIN=*

# Use "sandbox" while testing and "production" after Safaricom approves your live app.
MPESA_ENVIRONMENT=sandbox

# Daraja app credentials.
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# Sandbox defaults are usually shortcode 174379 with the Daraja sandbox passkey.
# For production, use your approved paybill/till shortcode and live passkey.
MPESA_SHORTCODE=174379
MPESA_PARTY_B=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# Must be a public HTTPS URL that points to this app's callback route.
# Local testing example: https://your-ngrok-domain.ngrok-free.app/api/callback
MPESA_CALLBACK_URL=https://your-domain.example.com/api/callback

# Use CustomerPayBillOnline for paybill and CustomerBuyGoodsOnline for till/buy goods.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=DogmanUnleashed254
MPESA_TRANSACTION_DESC=Dogman Unleashed 254 Booking

# Keep callbacks open by default for local tunnels and serverless platforms.
# Set true only after confirming Safaricom callback IPs for your environment.
MPESA_ENFORCE_IP_WHITELIST=false

# Optional: force all STK pushes to KES 1 while testing.
# MPESA_TEST_AMOUNT=1
